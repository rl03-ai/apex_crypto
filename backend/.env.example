# Apex Crypto API — variáveis de ambiente
# Copia para .env e preenche os valores

APP_NAME=Apex Crypto API
DEBUG=true
SECRET_KEY=muda-isto-em-producao-usa-openssl-rand-hex-32

# Base de dados — SQLite para dev, PostgreSQL para produção
DATABASE_URL=sqlite:///./apex_crypto.db
# DATABASE_URL=postgresql://user:password@localhost:5432/apex_crypto

# CORS — frontends permitidos
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# CoinGecko — deixar vazio para usar API pública (com rate limits)
# Para Pro: https://www.coingecko.com/en/api/pricing
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=

# DefiLlama — público, sem chave necessária (para módulo B)
DEFILLAMA_BASE_URL=https://api.llama.fi

# Scheduler — jobs de background
SCHEDULER_ENABLED=true
ALERT_CHECK_INTERVAL_MINUTES=10
PORTFOLIO_UPDATE_INTERVAL_MINUTES=15
